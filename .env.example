# Kibitz 설정 예시.
#
#   cp .env.example .env
#
# `.env` 는 gitignore 됩니다. 키를 이 파일(.env.example)에 적지 마세요 —
# 이건 저장소에 올라갑니다.
#
# **키는 전부 선택입니다.** 하나도 없어도 수집·탐지·트리·스킬 제안은 그대로 돕니다.
# 탐지에는 모델을 쓰지 않기 때문입니다. 키는 BYOK 분석(개선 제안)에만 씁니다.

# ── 웹 ─────────────────────────────────────────────────────────
KIBITZ_PORT=3000

# 이 배포가 우리가 띄우는 **공개 마케팅 사이트**인가. 설치본은 건드리지 마세요.
#   0 (기본) — `/` 는 대시보드. 자기 트레이스를 보러 온 사람에게 첫 화면은 그것이다.
#   1        — `/` 는 랜딩. 그리고 방문자 보호를 위해 함께 잠긴다:
#              붙여 넣은 API 키 거부, 토큰 없는 수집 거부, 서버 CLI 계정 사용 금지.
# 랜딩은 어느 쪽이든 /welcome 에 항상 있습니다.
KIBITZ_PUBLIC_SITE=0

# 네트워크에 노출할 때 설정. 로컬 단독 사용은 비워 둘 수 있습니다.
KIBITZ_INGEST_TOKEN=
KIBITZ_READ_TOKEN=

# Project별 token이 필요할 때 한 줄 JSON으로 설정합니다.
# KIBITZ_PROJECT_TOKENS={"prod-writer":{"project":"agent-prod","role":"ingest"}}
KIBITZ_PROJECT_TOKENS=

# ── BYOK 분석 제공자 (선택) ─────────────────────────────────────
# 서버에 두면 브라우저가 키를 보지 않습니다. 여러 개를 넣어 두고 화면에서 고를 수 있습니다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# ── Claude Code / Codex 계정 분석 (선택) ────────────────────────
# 로컬 개발은 기본 허용, production은 명시적으로 1을 설정해야 합니다.
# Kibitz는 credential 파일을 읽지 않고 설치된 CLI의 로그인 세션에만 위임합니다.
KIBITZ_ALLOW_LOCAL_CODE_AGENTS=0
# PATH에서 찾을 수 없을 때만 절대 경로를 지정하세요.
KIBITZ_CLAUDE_BIN=
KIBITZ_CODEX_BIN=

# ── Ollama (선택, 키 불필요) ────────────────────────────────────
# compose 로 ollama 프로파일을 띄우면 이 주소가 맞습니다.
# 호스트에 이미 ollama 가 돌고 있으면 http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_PORT=11434
